<?xml version="1.0" encoding="utf-8"?>
<!--
    item_trending_news.xml
    Card horizontal 260dp – gambar fullbleed, gradient overlay, teks di bawah.
    TIDAK ada referensi drawable icon (clock icon diganti karakter Unicode ⏱).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="210dp"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <!-- Gambar latar -->
    <ImageView
        android:id="@+id/ivTrendingImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="News image" />

    <!-- Gradient overlay: transparan atas → hitam bawah -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_overlay_trending" />

    <!-- Konten teks di atas overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Badge kategori: background di-set via kode, tidak butuh drawable -->
        <TextView
            android:id="@+id/tvTrendingCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#Technology"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/chip_category_overlay"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- Spacer dorong judul ke bawah -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Judul berita -->
        <TextView
            android:id="@+id/tvTrendingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Headline goes here"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <!-- Meta: waktu & penulis – ikon jam pakai karakter Unicode, tidak butuh drawable -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <!-- Karakter ⏱ sebagai pengganti ic_clock drawable -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱"
                android:textSize="11sp"
                android:textColor="#CCFFFFFF" />

            <TextView
                android:id="@+id/tvTrendingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 mins ago"
                android:textSize="11sp"
                android:textColor="#CCFFFFFF"
                android:layout_marginStart="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · "
                android:textSize="11sp"
                android:textColor="#CCFFFFFF" />

            <TextView
                android:id="@+id/tvTrendingAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="By Author Name"
                android:textSize="11sp"
                android:textColor="#CCFFFFFF"
                android:ellipsize="end"
                android:maxLines="1" />

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
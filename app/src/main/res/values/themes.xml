<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Kabarin" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1565C0</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#D0E4F7</item>

        <item name="android:windowBackground">#F5F7FA</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#0D1B2A</item>
        <item name="colorOnSurfaceVariant">#5A6878</item>
        <item name="colorOutline">#E8ECF0</item>

        <!-- Tambahkan ini untuk mengontrol warna ikon default (hamburger, dll) -->
        <item name="colorControlNormal">?attr/colorOnSurface</item>
    </style>

    <style name="Theme.Kabarin" parent="Base.Theme.Kabarin" />

    <!-- Ubah parent agar mendukung DayNight, bukan dipaksa Light -->
    <style name="Theme.Kabarin.AppBarOverlay" parent="ThemeOverlay.Material3.ActionBar" />
    <style name="Theme.Kabarin.PopupOverlay" parent="ThemeOverlay.Material3.DynamicColors.DayNight" />

    <style name="ShapeAppearance.Kabarin.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
